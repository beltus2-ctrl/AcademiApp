{
  "expo": {
    "name": "AcademiApp",
    "slug": "AcademiApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000814"
    },
"android": {
  "adaptiveIcon": {
    "foregroundImage": "./assets/adaptive-icon.png",
    "backgroundColor": "#000814"
  },
  "package": "cm.iutdouala.academiapp",
  "permissions": [
    "CAMERA",
    "READ_EXTERNAL_STORAGE",
    "WRITE_EXTERNAL_STORAGE",
    "RECORD_AUDIO",
    "VIBRATE",
    "RECEIVE_BOOT_COMPLETED"
  ]
},
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cm.iutdouala.academiapp"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "AcademiApp a besoin d acces a vos photos pour scanner vos notes.",
          "cameraPermission": "AcademiApp a besoin d acces a la camera pour scanner vos notes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4A90D9",
          "sounds": []
        }
      ],
      "expo-av"
    ],
    "scheme": "academiapp",
    "extra": {
      "eas": {
        "projectId": "4efb0a0c-d9aa-4d36-af06-164e4d8e58e3"
      }
    },
    "owner": "bel_tus"
  }
}
